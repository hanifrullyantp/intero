{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/3d/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/assets/(.*)",
      "has": [{ "type": "host", "value": "3d.intero.id" }],
      "destination": "/3d/assets/$1"
    },
    {
      "source": "/icons/(.*)",
      "has": [{ "type": "host", "value": "3d.intero.id" }],
      "destination": "/3d/icons/$1"
    },
    {
      "source": "/manifest.json",
      "has": [{ "type": "host", "value": "3d.intero.id" }],
      "destination": "/3d/manifest.json"
    },
    {
      "source": "/sw.js",
      "has": [{ "type": "host", "value": "3d.intero.id" }],
      "destination": "/3d/sw.js"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "3d.intero.id" }],
      "destination": "/3d/index.html"
    },
    {
      "source": "/v/:id",
      "has": [{ "type": "host", "value": "3d.intero.id" }],
      "destination": "/3d/index.html"
    },
    {
      "source": "/app",
      "has": [{ "type": "host", "value": "3d.intero.id" }],
      "destination": "/3d/index.html"
    },
    {
      "source": "/p/:id",
      "has": [{ "type": "host", "value": "3d.intero.id" }],
      "destination": "/3d/index.html"
    },
    {
      "source": "/api/:path*",
      "has": [{ "type": "host", "value": "3d.intero.id" }],
      "destination": "/api/:path*"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "3d.intero.id" }],
      "destination": "/3d/:path*"
    },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
