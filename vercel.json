{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/3d/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/assets/(.*)",
      "destination": "/3d/assets/$1",
      "has": [
        {
          "type": "host",
          "value": "3d.intero.id"
        }
      ]
    },
    {
      "source": "/icons/(.*)",
      "destination": "/3d/icons/$1",
      "has": [
        {
          "type": "host",
          "value": "3d.intero.id"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "destination": "/3d/manifest.json",
      "has": [
        {
          "type": "host",
          "value": "3d.intero.id"
        }
      ]
    },
    {
      "source": "/sw.js",
      "destination": "/3d/sw.js",
      "has": [
        {
          "type": "host",
          "value": "3d.intero.id"
        }
      ]
    },
    {
      "source": "/",
      "destination": "/3d/index.html",
      "has": [
        {
          "type": "host",
          "value": "3d.intero.id"
        }
      ]
    },
    {
      "source": "/v/:id",
      "destination": "/3d/index.html",
      "has": [
        {
          "type": "host",
          "value": "3d.intero.id"
        }
      ]
    },
    {
      "source": "/app",
      "destination": "/3d/index.html",
      "has": [
        {
          "type": "host",
          "value": "3d.intero.id"
        }
      ]
    },
    {
      "source": "/p/:id",
      "destination": "/3d/index.html",
      "has": [
        {
          "type": "host",
          "value": "3d.intero.id"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*",
      "has": [
        {
          "type": "host",
          "value": "3d.intero.id"
        }
      ]
    },
    {
      "source": "/:path*",
      "destination": "/3d/:path*",
      "has": [
        {
          "type": "host",
          "value": "3d.intero.id"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "destination": "/3d/assets/$1",
      "has": [
        {
          "type": "host",
          "value": "3d.intero.com"
        }
      ]
    },
    {
      "source": "/icons/(.*)",
      "destination": "/3d/icons/$1",
      "has": [
        {
          "type": "host",
          "value": "3d.intero.com"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "destination": "/3d/manifest.json",
      "has": [
        {
          "type": "host",
          "value": "3d.intero.com"
        }
      ]
    },
    {
      "source": "/sw.js",
      "destination": "/3d/sw.js",
      "has": [
        {
          "type": "host",
          "value": "3d.intero.com"
        }
      ]
    },
    {
      "source": "/",
      "destination": "/3d/index.html",
      "has": [
        {
          "type": "host",
          "value": "3d.intero.com"
        }
      ]
    },
    {
      "source": "/v/:id",
      "destination": "/3d/index.html",
      "has": [
        {
          "type": "host",
          "value": "3d.intero.com"
        }
      ]
    },
    {
      "source": "/app",
      "destination": "/3d/index.html",
      "has": [
        {
          "type": "host",
          "value": "3d.intero.com"
        }
      ]
    },
    {
      "source": "/p/:id",
      "destination": "/3d/index.html",
      "has": [
        {
          "type": "host",
          "value": "3d.intero.com"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*",
      "has": [
        {
          "type": "host",
          "value": "3d.intero.com"
        }
      ]
    },
    {
      "source": "/:path*",
      "destination": "/3d/:path*",
      "has": [
        {
          "type": "host",
          "value": "3d.intero.com"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
