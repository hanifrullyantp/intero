{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/3d/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "3d.intero.id" }],
      "destination": "/3d/index.html"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "3d.intero.id" }],
      "destination": "/3d/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
