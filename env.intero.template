# =============================================================================
# Intero — Supabase & lokal (TEMPLATE)
# =============================================================================
# 1. Salin file ini jadi `.env.local` di folder yang sama (root repo):
#      cp env.intero.template .env.local
# 2. Salin juga ke app 3D (supaya `npm run dev` di "3D Intero" baca env):
#      cp env.intero.template "3D Intero/.env.local"
# 3. Isi nilai kosong di bawah, simpan. Jangan commit `.env.local`.
#
# Project production (3d.intero.com / 3d.intero.id):
#   Dashboard: https://supabase.com/dashboard/project/fctrxjanqegjmhoklnje
# =============================================================================

# --- Supabase CLI (untuk migrasi: supabase login / db push) ---
# Buat token: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# --- Project URL (ref: fctrxjanqegjmhoklnje) ---
# Settings → API: https://supabase.com/dashboard/project/fctrxjanqegjmhoklnje/settings/api
SUPABASE_URL=https://fctrxjanqegjmhoklnje.supabase.co
VITE_SUPABASE_URL=https://fctrxjanqegjmhoklnje.supabase.co

# anon public (aman di browser / Vite)
VITE_SUPABASE_ANON_KEY=

# service_role — RAHASIA, hanya server/CLI, jangan di frontend
# Ambil di halaman API yang sama (tombol Reveal service_role)
SUPABASE_SERVICE_ROLE_KEY=

# --- SQL manual (jika tidak pakai CLI) ---
# SQL Editor: https://supabase.com/dashboard/project/fctrxjanqegjmhoklnje/sql/new
# Migrasi otomatis: node scripts/run-supabase-migrations.mjs (butuh SUPABASE_ACCESS_TOKEN)
#
# --- Auth OAuth redirect (wajib untuk Google/Apple) ---
# Authentication → URL Configuration:
#   Site URL: https://3d.intero.com  (atau domain utama yang dipakai)
#   Redirect URLs (tambahkan semua domain production):
#     https://3d.intero.com/?oauth=1
#     https://3d.intero.id/?oauth=1
#     http://localhost:5173/?oauth=1

# --- Instant 3D build / share link (domain canonical untuk share URL) ---
VITE_3D_PUBLIC_ORIGIN=https://3d.intero.com

# --- Opsional: dev API lokal (landing admin + share API fallback) ---
PORT=8787
JWT_SECRET=dev-jwt-minimal-16-chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-password-ini
